<MudDialog>
	<TitleContent>
		<MudText Typo="Typo.h6">Queue: @Item.Name</MudText>
	</TitleContent>
	<DialogContent>
		<MudStack Spacing="3">
			<MudText Typo="Typo.body2">
				<strong>Type:</strong> @Item.Type
				@if (Item.ProductionYear.HasValue)
				{
					@($" ({Item.ProductionYear})")
				}
			</MudText>

			<MudSelect Value="_destServerId" Label="Destination Server" Variant="Variant.Outlined"
				AnchorOrigin="Origin.BottomCenter"
				ValueChanged="@((Guid v) => OnDestServerChangedAsync(v))">
				@foreach (var server in _destServers)
				{
					<MudSelectItem Value="server.Id">@server.Name</MudSelectItem>
				}
			</MudSelect>

			@if (_isLoadingOptions)
			{
				<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
					<MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
					<MudText Typo="Typo.caption">Loading destination paths...</MudText>
				</MudStack>
			}
			else if (_destOptions.Count > 0)
			{
				<MudSelect @bind-Value="_selectedOption" T="DestinationRootOption"
					Label="Destination Path" Variant="Variant.Outlined"
					ToStringFunc="@(o => o?.DisplayName ?? string.Empty)"
					AnchorOrigin="Origin.BottomCenter">
					@foreach (var opt in _destOptions)
					{
						<MudSelectItem Value="opt">@opt.DisplayName</MudSelectItem>
					}
				</MudSelect>
			}

			<MudSelect @bind-Value="_presetLabel" Label="Encoding Preset" Variant="Variant.Outlined"
				AnchorOrigin="Origin.BottomCenter">
				@foreach (var preset in _presets)
				{
					<MudSelectItem Value="@preset.Label">@preset.Label</MudSelectItem>
				}
			</MudSelect>
		</MudStack>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">Cancel</MudButton>
		<MudButton Variant="Variant.Filled" Color="Color.Primary"
			OnClick="QueueAsync" Disabled="@(!CanQueue || _isQueueing)">
			@if (_isQueueing)
			{
				<MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
			}
			Queue
		</MudButton>
	</DialogActions>
</MudDialog>
