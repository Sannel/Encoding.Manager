<MudCard Class="mb-4 pa-4">
	<MudText Typo="Typo.h6" Class="mb-2">Set up your AI client</MudText>
	@if (!HasKey)
	{
		<MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
			The snippets below use the placeholder <code>@KeyPlaceholder</code>. Replace it with your key.
			If you no longer have your key, rotate it to get a new one.
		</MudAlert>
	}
	<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">
		@foreach (var snippet in Snippets)
		{
			<MudTabPanel Text="@snippet.Title">
				<MudText Typo="Typo.body2" Class="mb-2">@snippet.Help</MudText>
				<MudPaper Outlined="true" Class="pa-3" Style="position:relative;">
					<MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
						Style="position:absolute; top:4px; right:4px;"
						OnClick="@(() => CopyAsync(snippet.Text))" aria-label="Copy snippet" />
					<pre style="margin:0; white-space:pre-wrap; word-break:break-all; font-family:monospace; font-size:.85rem;">@snippet.Text</pre>
				</MudPaper>
			</MudTabPanel>
		}
	</MudTabs>
</MudCard>
