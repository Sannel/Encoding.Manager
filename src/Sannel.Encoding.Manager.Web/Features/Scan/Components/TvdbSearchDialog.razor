@using Sannel.Encoding.Manager.Web.Features.Tvdb.Dto

<MudDialog>
	<TitleContent>
		<MudText Typo="Typo.h6">Search for TV Show</MudText>
	</TitleContent>
	<DialogContent>
		<MudStack Spacing="2">
			<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
				<MudTextField @bind-Value="_searchTerm" Label="Show Name" Variant="Variant.Outlined"
					Placeholder="e.g. Breaking Bad" FullWidth="true"
					@onkeydown="OnKeyDown" />
				<MudButton Variant="Variant.Filled" Color="Color.Primary"
					OnClick="SearchAsync" Disabled="@(_isSearching || string.IsNullOrWhiteSpace(_searchTerm))">
					@if (_isSearching)
					{
						<MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
					}
					Search
				</MudButton>
			</MudStack>

			@if (!string.IsNullOrEmpty(_errorMessage))
			{
				<MudAlert Severity="Severity.Error" Dense="true">@_errorMessage</MudAlert>
			}

			@if (_results.Count > 0)
			{
				<MudList T="TvdbSeriesSearchResult" Dense="true" Style="max-height: 320px; overflow-y: auto; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;">
					@foreach (var result in _results)
					{
						var r = result;
						<MudListItem T="TvdbSeriesSearchResult" OnClick="@(() => SelectResult(r))">
							<MudStack Spacing="0">
								<MudText Typo="Typo.body1">
									<strong>@result.Name</strong>
									@if (!string.IsNullOrEmpty(result.Year))
									{
										<span class="ml-1" style="opacity: .7;">(@result.Year)</span>
									}
								</MudText>
								@if (!string.IsNullOrEmpty(result.Overview))
								{
									<MudText Typo="Typo.body2" Style="opacity: .6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 440px;">
										@result.Overview
									</MudText>
								}
							</MudStack>
						</MudListItem>
					}
				</MudList>
			}
			else if (_searched && !_isSearching)
			{
				<MudAlert Severity="Severity.Info" Dense="true">No results found.</MudAlert>
			}
		</MudStack>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">Cancel</MudButton>
	</DialogActions>
</MudDialog>
