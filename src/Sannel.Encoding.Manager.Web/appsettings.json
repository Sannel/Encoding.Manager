{
	"Database": {
		"Provider": "sqlite",
		"ConnectionString": "Data Source=data/encoding.db"
	},
	"AzureAd": {
		"Instance": "https://login.microsoftonline.com/",
		"Domain": "yourdomain.onmicrosoft.com",
		"TenantId": "your-tenant-id-guid",
		"ClientId": "your-client-id-guid",
		"ClientSecret": "-- never store secrets here; use user-secrets or environment variables --",
		"CallbackPath": "/signin-oidc",
		"SignedOutCallbackPath": "/signout-callback-oidc"
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"HandBrake": {
		"ExecutablePath": "",
		"ScanOutputPath": "handbrake-scans",
		"MinimumVersion": "1.10"
	},
	"Tvdb": {
		"BaseUrl": "https://api4.thetvdb.com/v4",
		"ApiKey": ""
	},
	"Omdb": {
		"BaseUrl": "https://www.omdbapi.com/",
		"ApiKey": ""
	},
	"Queue": {
		"PageSize": 50
	},
	"Filesystem": {
		"Roots": [
			/*{
				"Label": "Q",
				"Path": "/mnt/q"
			},
			{
				"Label": "G",
				"Path": "/mnt/g"
			}*/
		]
	},
	"Mcp": {
		"Enabled": true,
		"ScanWaitSeconds": 5,
		"ForcedRescanPermitLimit": 3,
		"ForcedRescanWindowMinutes": 10
	},
	"DiscMenu": {
		"Enabled": true,
		"JavaHome": null,
		"LibBlurayJarPath": null,
		"NativeLibraryPath": null,
		"OutputPath": "disc-menus",
		"ProbeTimeoutSeconds": 1800,
		"MaxConcurrentProbes": 1,
		"TimeBudgetSeconds": 1350,
		"MenuLanguage": "en"
	},
	"Interlace": {
		"Enabled": true,
		"FfmpegPath": null,
		"SamplePoints": [ 0.10, 0.45, 0.80 ],
		"FramesPerSample": 500,
		"ProbeTimeoutSeconds": 120,
		"MaxConcurrentProbes": 1,
		"InterlacedThresholdPercent": 10,
		"TelecineThresholdPercent": 10
	},
	"Presets": {
		"InterlacedPresetLabel": "4K AV1 Decomb",
		"ProgressivePresetLabel": "4K AV1"
	}
}
